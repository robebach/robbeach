---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import { projects } from "../data/projects";

const pageTitle = "Work | Robert Beach";
const pageDescription =
	"Selected projects across software development, building science, data analytics, fabrication, and architectural research.";

// Load all potential gallery images eagerly to find first thumbnail for each project
const allGalleryImages = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/galleries/**/*.{jpeg,jpg,png,gif,webp,JPG,JPEG,PNG,WEBP}",
	{ eager: true }
);

function getFirstGalleryImage(galleryId?: string): ImageMetadata | null {
	if (!galleryId) return null;
	const prefix = `/src/assets/galleries/${galleryId}/`;
	const matchingKey = Object.keys(allGalleryImages)
		.filter((key) => key.startsWith(prefix))
		.sort()[0];
	return matchingKey ? allGalleryImages[matchingKey].default : null;
}

const visibleProjects = projects.filter((p) => !p.hidden);
---

<SiteLayout title={pageTitle} description={pageDescription} active="projects">
	<header class="projects-header content-measure mb-5">
		<p class="section-label">Selected Work</p>
		<h1 class="projects-title">
			Software, hardware, science,<br />architecture.
		</h1>
		<p class="projects-intro">
			A selection of projects spanning the last two decades — from graduate
			architecture studios to published geoscience research to the engineering
			systems running in tens of thousands of homes.
		</p>
	</header>

	<section aria-label="Project list">
		<ol class="project-list" role="list">
			{
				visibleProjects.map((project, i) => {
					const thumbImg = getFirstGalleryImage(project.galleryId);
					return (
						<li class="project-item">
							<a
								class="project-link"
								href={`/projects/${project.slug}`}
								aria-label={project.name}
							>
								<div class="project-thumb">
									{thumbImg ? (
										<Image
											src={thumbImg}
											alt={project.name}
											class="project-thumb-img"
											width={160}
											height={259}
											format="webp"
											loading="lazy"
										/>
									) : (
										<div class="project-thumb-placeholder">
											<span class="placeholder-code">{String(i + 1).padStart(2, "0")}</span>
										</div>
									)}
								</div>
								<div class="project-meta">
									<span class="project-index">{String(i + 1).padStart(2, "0")}</span>
									<span class="project-period">{project.period ?? "—"}</span>
								</div>
								<div class="project-body">
									<h2 class="project-name">{project.name}</h2>
									<p class="project-summary">{project.summary}</p>
									<ul class="tag-list" aria-label="Tags">
										{project.details.slice(0, 5).map((d) => (
											<li class="tag">{d}</li>
										))}
									</ul>
								</div>
								<span class="project-arrow" aria-hidden="true">&rarr;</span>
							</a>
						</li>
					);
				})
			}
		</ol>
	</section>
</SiteLayout>

<style>
	.section-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-3);
		margin: 0 0 1.25rem;
	}

	.projects-title {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 300;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--ink);
		margin: 0 0 1.25rem;
	}

	.projects-intro {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--ink-2);
		margin: 0;
	}

	/* ─── Project list ───────────────────────────────────────── */
	.project-list {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--rule);
	}

	.project-item {
		border-bottom: 1px solid var(--rule);
	}

	.project-link {
		display: grid;
		grid-template-columns: 4.5rem 2.25rem 1fr auto;
		gap: 1.25rem;
		align-items: start;
		padding: 1.75rem 0;
		text-decoration: none;
		color: inherit;
		transition: background 0.12s ease;
	}

	@media (min-width: 768px) {
		.project-link {
			padding-right: 3rem;
		}
	}

	@media (min-width: 992px) {
		.project-link {
			padding-right: 6rem;
		}
	}

	@media (min-width: 1200px) {
		.project-link {
			padding-right: 10rem;
		}
	}

	.project-link:hover {
		opacity: 1;
	}

	.project-link:hover .project-name {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.project-link:hover .project-arrow {
		transform: translateX(4px);
		color: var(--ink);
	}

	/* Thumbnail Column (Golden Ratio Vertical: 1 : 1.618) */
	.project-thumb {
		width: 4.5rem;
		aspect-ratio: 1 / 1.618;
		border-radius: 4px;
		overflow: hidden;
		background: var(--surface-2);
		border: 1px solid var(--rule);
		flex-shrink: 0;
	}

	.project-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.project-link:hover .project-thumb-img {
		transform: scale(1.08);
	}

	.project-thumb-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--surface-2);
		color: var(--ink-3);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

	@media (max-width: 640px) {
		.project-link {
			grid-template-columns: 3.75rem 1fr auto;
			grid-template-rows: auto auto;
			gap: 1rem;
		}

		.project-thumb {
			grid-column: 1;
			grid-row: 1;
			width: 3.75rem;
		}

		.project-meta {
			grid-column: 2;
			grid-row: 1;
			flex-direction: row !important;
			align-items: center !important;
			gap: 0.75rem !important;
		}

		.project-period {
			writing-mode: horizontal-tb !important;
			transform: none !important;
		}

		.project-arrow {
			grid-column: 3;
			grid-row: 1;
		}

		.project-body {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}

	/* Meta column */
	.project-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		padding-top: 0.15rem;
	}

	.project-index {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--ink-3);
		letter-spacing: 0.05em;
		line-height: 1;
	}

	.project-period {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--ink-3);
		white-space: nowrap;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		letter-spacing: 0.08em;
		opacity: 0.8;
	}

	/* Body column */
	.project-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.project-name {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		color: var(--ink);
		margin: 0;
		line-height: 1.3;
	}

	.project-summary {
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-2);
		margin: 0;
	}

	/* Arrow */
	.project-arrow {
		font-size: 1rem;
		color: var(--ink-3);
		padding-top: 0.2rem;
		transition: transform 0.15s ease, color 0.15s ease;
	}
</style>
