---
import SiteLayout from "../layouts/SiteLayout.astro";
import { projects } from "../data/projects";

const pageTitle = "Work | Robert Beach";
const pageDescription =
	"Selected projects across software development, building science, data analytics, fabrication, and architectural research.";
---

<SiteLayout title={pageTitle} description={pageDescription} active="projects">
	<header class="projects-header content-measure mb-5">
		<p class="section-label">Selected Work</p>
		<h1 class="projects-title">
			Software, hardware, science,<br />architecture.
		</h1>
		<p class="projects-intro">
			A selection of projects spanning the last two decades — from graduate
			architecture studios to published geoscience research to the engineering
			systems running in tens of thousands of homes.
		</p>
	</header>

	<section aria-label="Project list">
		<ol class="project-list" role="list">
			{
				projects.map((project, i) => (
					<li class="project-item">
						<a
							class="project-link"
							href={`/projects/${project.slug}`}
							aria-label={project.name}
						>
							<div class="project-meta">
								<span class="project-index">{String(i + 1).padStart(2, "0")}</span>
								<span class="project-period">{project.period ?? "—"}</span>
							</div>
							<div class="project-body">
								<h2 class="project-name">{project.name}</h2>
								<p class="project-summary">{project.summary}</p>
								<ul class="tag-list" aria-label="Tags">
									{project.details.slice(0, 5).map((d) => (
										<li class="tag">{d}</li>
									))}
								</ul>
							</div>
							<span class="project-arrow" aria-hidden="true">&rarr;</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>
</SiteLayout>

<style>
	.section-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-3);
		margin: 0 0 1.25rem;
	}

	.projects-title {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 300;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--ink);
		margin: 0 0 1.25rem;
	}

	.projects-intro {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--ink-2);
		margin: 0;
	}

	/* ─── Project list ───────────────────────────────────────── */
	.project-list {
		list-style: none;
		padding: 0;
		margin: 0;
		border-top: 1px solid var(--rule);
	}

	.project-item {
		border-bottom: 1px solid var(--rule);
	}

	.project-link {
		display: grid;
		grid-template-columns: 6rem 1fr auto;
		gap: 1.5rem;
		align-items: start;
		padding: 1.75rem 0;
		text-decoration: none;
		color: inherit;
		transition: background 0.12s ease;
	}

	.project-link:hover {
		opacity: 1;
	}

	.project-link:hover .project-name {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.project-link:hover .project-arrow {
		transform: translateX(4px);
		color: var(--ink);
	}

	@media (max-width: 640px) {
		.project-link {
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto;
		}

		.project-meta {
			grid-column: 1;
			grid-row: 1;
		}

		.project-body {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.project-arrow {
			grid-column: 2;
			grid-row: 1;
		}
	}

	/* Meta column */
	.project-meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		padding-top: 0.2rem;
	}

	.project-index {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--ink-3);
		letter-spacing: 0.05em;
	}

	.project-period {
		font-family: var(--font-mono);
		font-size: 0.675rem;
		color: var(--ink-3);
		white-space: nowrap;
	}

	/* Body column */
	.project-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.project-name {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		color: var(--ink);
		margin: 0;
		line-height: 1.3;
	}

	.project-summary {
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-2);
		margin: 0;
	}

	/* Arrow */
	.project-arrow {
		font-size: 1rem;
		color: var(--ink-3);
		padding-top: 0.2rem;
		transition: transform 0.15s ease, color 0.15s ease;
	}
</style>
