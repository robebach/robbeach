---
import { Image } from "astro:assets";
import SiteLayout from "../layouts/SiteLayout.astro";
import { projects } from "../data/projects";

const pageTitle = "Work | Robert Beach";
const pageDescription =
	"Selected projects across software development, building science, data analytics, fabrication, and architectural research.";

// Load all potential gallery images eagerly to find first thumbnail for each project
const allGalleryImages = import.meta.glob<{ default: ImageMetadata }>(
	"/src/assets/galleries/**/*.{jpeg,jpg,png,gif,webp,JPG,JPEG,PNG,WEBP}",
	{ eager: true }
);

function getFirstGalleryImage(galleryId?: string): ImageMetadata | null {
	if (!galleryId) return null;
	const prefix = `/src/assets/galleries/${galleryId}/`;
	const matchingKey = Object.keys(allGalleryImages)
		.filter((key) => key.startsWith(prefix))
		.sort()[0];
	return matchingKey ? allGalleryImages[matchingKey].default : null;
}

// Auto-sort projects by date (most recent year first) as default
const sortedProjects = projects
	.filter((p) => !p.hidden)
	.sort((a, b) => (b.sortYear ?? 0) - (a.sortYear ?? 0));

const categories = [
	{ id: "all", label: "All Work" },
	{ id: "building-science", label: "Building Science" },
	{ id: "software-computation", label: "Software & Computation" },
	{ id: "fabrication", label: "Digital Fabrication" },
	{ id: "architecture", label: "Architecture" },
	{ id: "scientific-research", label: "Scientific Research" },
];
---

<SiteLayout title={pageTitle} description={pageDescription} active="projects">
	<header class="projects-header content-measure mb-4">
		<p class="section-label">Selected Work</p>
		<h1 class="projects-title">
			Software, hardware, science,<br />architecture.
		</h1>
		<p class="projects-intro">
			A selection of projects spanning the last two decades — from graduate
			architecture studios to published geoscience research to the engineering
			systems running in tens of thousands of homes.
		</p>
	</header>

	<!-- Filter & Sort Controls -->
	<section class="controls-section mb-4" aria-label="Project filter and sort controls">
		<div class="controls-wrapper">
			<div class="filter-chips-container" role="tablist" aria-label="Filter projects by discipline">
				{
					categories.map((cat) => (
						<button
							class={`filter-chip ${cat.id === "all" ? "active" : ""}`}
							data-category={cat.id}
							role="tab"
							aria-selected={cat.id === "all" ? "true" : "false"}
						>
							{cat.label}
						</button>
					))
				}
			</div>

			<div class="sort-control-container">
				<label for="project-sort" class="sort-label">Sort by:</label>
				<div class="select-wrapper">
					<select id="project-sort" class="sort-select" aria-label="Sort projects">
						<option value="recent">Most Recent (Default)</option>
						<option value="oldest">Oldest First</option>
						<option value="name">Alphabetical (A–Z)</option>
					</select>
					<span class="select-arrow" aria-hidden="true">▾</span>
				</div>
			</div>
		</div>
		<div class="active-count-bar">
			<span id="project-count" class="project-count-text">Showing {sortedProjects.length} projects</span>
		</div>
	</section>

	<section aria-label="Project list">
		<ol class="project-list" id="project-list" role="list">
			{
				sortedProjects.map((project, i) => {
					const thumbImg = getFirstGalleryImage(project.galleryId);
					return (
						<li
							class="project-item"
							data-categories={JSON.stringify(project.categories ?? [])}
							data-sort-year={project.sortYear ?? 0}
							data-name={project.name.toLowerCase()}
						>
							<a
								class="project-link"
								href={`/projects/${project.slug}`}
								aria-label={project.name}
							>
								<div class="project-thumb">
									{thumbImg ? (
										<Image
											src={thumbImg}
											alt={project.name}
											class="project-thumb-img"
											width={160}
											height={259}
											format="webp"
											loading="lazy"
										/>
									) : (
										<div class="project-thumb-placeholder">
											<span class="placeholder-code">{String(i + 1).padStart(2, "0")}</span>
										</div>
									)}
								</div>
								<div class="project-meta">
									<span class="project-index">{String(i + 1).padStart(2, "0")}</span>
									<span class="project-period">{project.period ?? "—"}</span>
								</div>
								<div class="project-body">
									<h2 class="project-name">{project.name}</h2>
									<p class="project-summary">{project.summary}</p>
									<ul class="tag-list" aria-label="Tags">
										{project.details.slice(0, 5).map((d) => (
											<li class="tag">{d}</li>
										))}
									</ul>
								</div>
								<span class="project-arrow" aria-hidden="true">&rarr;</span>
							</a>
						</li>
					);
				})
			}
		</ol>
	</section>
</SiteLayout>

<script>
	function setupProjectFilters() {
		const filterChips = document.querySelectorAll<HTMLButtonElement>(".filter-chip");
		const sortSelect = document.querySelector<HTMLSelectElement>("#project-sort");
		const projectList = document.querySelector<HTMLOListElement>("#project-list");
		const projectCount = document.querySelector<HTMLSpanElement>("#project-count");

		if (!projectList) return;

		let currentCategory = "all";
		let currentSort = "recent";

		function updateList() {
			const items = Array.from(projectList.querySelectorAll<HTMLLIElement>(".project-item"));

			// 1. Filter items
			let visibleItems = items.filter((item) => {
				if (currentCategory === "all") return true;
				try {
					const cats: string[] = JSON.parse(item.dataset.categories || "[]");
					return cats.includes(currentCategory);
				} catch {
					return true;
				}
			});

			// Hide non-matching items, show matching items
			items.forEach((item) => {
				if (visibleItems.includes(item)) {
					item.style.display = "";
				} else {
					item.style.display = "none";
				}
			});

			// 2. Sort visible items
			visibleItems.sort((a, b) => {
				const yearA = parseFloat(a.dataset.sortYear || "0");
				const yearB = parseFloat(b.dataset.sortYear || "0");
				const nameA = a.dataset.name || "";
				const nameB = b.dataset.name || "";

				if (currentSort === "recent") {
					return yearB - yearA;
				} else if (currentSort === "oldest") {
					return yearA - yearB;
				} else if (currentSort === "name") {
					return nameA.localeCompare(nameB);
				}
				return 0;
			});

			// Re-append in new order
			visibleItems.forEach((item, index) => {
				projectList.appendChild(item);
				// Update visible index number (01, 02, 03...)
				const indexEl = item.querySelector<HTMLSpanElement>(".project-index");
				if (indexEl) {
					indexEl.textContent = String(index + 1).padStart(2, "0");
				}
			});

			// 3. Update count label
			if (projectCount) {
				const catLabel = currentCategory === "all" ? "" : ` in ${currentCategory.replace("-", " ")}`;
				projectCount.textContent = `Showing ${visibleItems.length} project${visibleItems.length === 1 ? "" : "s"}${catLabel}`;
			}
		}

		// Chip click handlers
		filterChips.forEach((chip) => {
			chip.addEventListener("click", () => {
				filterChips.forEach((c) => {
					c.classList.remove("active");
					c.setAttribute("aria-selected", "false");
				});
				chip.classList.add("active");
				chip.setAttribute("aria-selected", "true");
				currentCategory = chip.dataset.category || "all";
				updateList();
			});
		});

		// Sort select change handler
		if (sortSelect) {
			sortSelect.addEventListener("change", (e) => {
				const target = e.target as HTMLSelectElement;
				currentSort = target.value;
				updateList();
			});
		}
	}

	// Initialize on page load and Astro view transitions
	setupProjectFilters();
	document.addEventListener("astro:page-load", setupProjectFilters);
</script>

<style>
	.section-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--ink-3);
		margin: 0 0 1.25rem;
	}

	.projects-title {
		font-size: clamp(1.75rem, 4vw, 2.5rem);
		font-weight: 300;
		line-height: 1.2;
		letter-spacing: -0.02em;
		color: var(--ink);
		margin: 0 0 1.25rem;
	}

	.projects-intro {
		font-size: 1rem;
		line-height: 1.7;
		color: var(--ink-2);
		margin: 0;
	}

	/* ─── Controls Section ───────────────────────────────────── */
	.controls-section {
		border-top: 1px solid var(--rule);
		border-bottom: 1px solid var(--rule);
		padding: 1.25rem 0 0.85rem;
		margin-top: 2rem;
	}

	.controls-wrapper {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}

	.filter-chips-container {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: center;
	}

	.filter-chip {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		letter-spacing: 0.03em;
		padding: 0.4rem 0.85rem;
		border-radius: 9999px;
		background: transparent;
		color: var(--ink-2);
		border: 1px solid var(--rule);
		cursor: pointer;
		transition: all 0.15s ease;
		white-space: nowrap;
	}

	.filter-chip:hover {
		color: var(--ink);
		border-color: var(--ink-3);
		background: var(--surface-2);
	}

	.filter-chip.active {
		background: var(--ink);
		color: var(--bg);
		border-color: var(--ink);
	}

	/* Sort dropdown */
	.sort-control-container {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.sort-label {
		color: var(--ink-3);
		letter-spacing: 0.04em;
	}

	.select-wrapper {
		position: relative;
		display: inline-flex;
		align-items: center;
	}

	.sort-select {
		appearance: none;
		-webkit-appearance: none;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--ink);
		background: var(--surface);
		border: 1px solid var(--rule);
		border-radius: 6px;
		padding: 0.4rem 1.8rem 0.4rem 0.75rem;
		cursor: pointer;
		outline: none;
		transition: border-color 0.15s ease;
	}

	.sort-select:hover,
	.sort-select:focus {
		border-color: var(--ink-3);
	}

	.select-arrow {
		position: absolute;
		right: 0.6rem;
		pointer-events: none;
		font-size: 0.65rem;
		color: var(--ink-3);
	}

	.active-count-bar {
		margin-top: 0.85rem;
	}

	.project-count-text {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--ink-3);
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}

	/* ─── Project list ───────────────────────────────────────── */
	.project-list {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.project-item {
		border-bottom: 1px solid var(--rule);
	}

	.project-link {
		display: grid;
		grid-template-columns: 4.5rem 2.25rem 1fr auto;
		gap: 1.25rem;
		align-items: start;
		padding: 1.75rem 0;
		text-decoration: none;
		color: inherit;
		transition: background 0.12s ease;
	}

	@media (min-width: 768px) {
		.project-link {
			padding-right: 3rem;
		}
	}

	@media (min-width: 992px) {
		.project-link {
			padding-right: 6rem;
		}
	}

	@media (min-width: 1200px) {
		.project-link {
			padding-right: 10rem;
		}
	}

	.project-link:hover {
		opacity: 1;
	}

	.project-link:hover .project-name {
		text-decoration: underline;
		text-underline-offset: 0.15em;
	}

	.project-link:hover .project-arrow {
		transform: translateX(4px);
		color: var(--ink);
	}

	/* Thumbnail Column (Golden Ratio Vertical: 1 : 1.618) */
	.project-thumb {
		width: 4.5rem;
		aspect-ratio: 1 / 1.618;
		border-radius: 4px;
		overflow: hidden;
		background: var(--surface-2);
		border: 1px solid var(--rule);
		flex-shrink: 0;
	}

	.project-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
	}

	.project-link:hover .project-thumb-img {
		transform: scale(1.08);
	}

	.project-thumb-placeholder {
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		background: var(--surface-2);
		color: var(--ink-3);
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.05em;
	}

	@media (max-width: 640px) {
		.project-link {
			grid-template-columns: 3.75rem 1fr auto;
			grid-template-rows: auto auto;
			gap: 1rem;
		}

		.project-thumb {
			grid-column: 1;
			grid-row: 1;
			width: 3.75rem;
		}

		.project-meta {
			grid-column: 2;
			grid-row: 1;
			flex-direction: row !important;
			align-items: center !important;
			gap: 0.75rem !important;
		}

		.project-period {
			writing-mode: horizontal-tb !important;
			transform: none !important;
		}

		.project-arrow {
			grid-column: 3;
			grid-row: 1;
		}

		.project-body {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}

	/* Meta column */
	.project-meta {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.5rem;
		padding-top: 0.15rem;
	}

	.project-index {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		color: var(--ink-3);
		letter-spacing: 0.05em;
		line-height: 1;
	}

	.project-period {
		font-family: var(--font-mono);
		font-size: 0.625rem;
		color: var(--ink-3);
		white-space: nowrap;
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		letter-spacing: 0.08em;
		opacity: 0.8;
	}

	/* Body column */
	.project-body {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.project-name {
		font-size: 1rem;
		font-weight: 500;
		letter-spacing: -0.005em;
		color: var(--ink);
		margin: 0;
		line-height: 1.3;
	}

	.project-summary {
		font-size: 0.875rem;
		line-height: 1.6;
		color: var(--ink-2);
		margin: 0;
	}

	/* Arrow */
	.project-arrow {
		font-size: 1rem;
		color: var(--ink-3);
		padding-top: 0.2rem;
		transition: transform 0.15s ease, color 0.15s ease;
	}
</style>
