---

<SiteLayout
	title="Resume | Robert Beach"
	description="Resume for Robert Beach."
	active="resume"
>
	<section class="mb-4">
		<p class="text-uppercase small text-secondary fw-semibold mb-2">Resume</p>
		<div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3">
			<div class="content-measure">
				<h1 class="display-6 fw-normal text-dark mb-2">Robert Beach</h1>
				<p class="lead text-secondary mb-2">
					Software Developer & Systems Specialist | Simulation Engines, Data Pipelines, Building Science & Hardware R&D
				</p>
				<p class="text-secondary mb-0">Phoenix, Arizona, United States</p>
			</div>
			<div class="d-flex flex-wrap gap-2 no-print">
				<a class="btn btn-outline-dark flex-shrink-0" href="mailto:robert.k.beach@gmail.com">
					Contact
				</a>
				<button class="btn btn-dark flex-shrink-0" type="button" onclick="window.print()">
					Print / Save PDF
				</button>
			</div>
		</div>
	</section>

	<section class="resume-section">
		<div class="card">
			<div class="card-body">
				<h2 class="h5 fw-medium text-dark mb-3">Profile</h2>
				<p class="text-secondary mb-0">
					Systems specialist working at the intersection of building physics, simulation software, and product development. I build calculation engines, data pipelines, and control logic that make physical HVAC systems predictable, verifiable, and efficient across design, field, and manufacturing workflows.
				</p>
			</div>
		</div>
	</section>

	<section class="resume-section">
		<h2 class="h4 mb-3">Highlights</h2>
		<div class="row g-3">
			{
				highlights.map((highlight) => (
					<div class="col-md-6">
						<div class="card h-100">
							<div class="card-body py-3">
								<p class="mb-0">{highlight}</p>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="resume-section">
		<h2 class="h4 mb-3">Selected Technical Work</h2>
		<div class="row g-3">
			{
				selectedWork.map((item) => (
					<div class="col-lg-6">
						<article class="card h-100">
							<div class="card-body">
								<h3 class="h6">{item.title}</h3>
								<p class="small text-secondary mb-0">{item.description}</p>
							</div>
						</article>
					</div>
				))
			}
		</div>
	</section>

	<section class="resume-section">
		<h2 class="h4 mb-3">Experience</h2>
		<div class="vstack gap-3">
			{
				experience.map((item) => (
					<article class="card">
						<div class="card-body">
							<div class="d-flex flex-column flex-md-row justify-content-between gap-2">
								<div>
									<h3 class="h5 mb-1">{item.role}</h3>
									<p class="text-secondary mb-1">{item.org}</p>
									<p class="small text-secondary mb-2">{item.location}</p>
								</div>
								<p class="small text-secondary mb-0">{item.time}</p>
							</div>
							<ul class="mb-0">
								{item.points.map((point) => (
									<li>{point}</li>
								))}
							</ul>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="resume-section">
		<h2 class="h4 mb-3">Skills</h2>
		<div class="row g-3">
			{
				skillGroups.map((group) => (
					<div class="col-lg-6">
						<div class="card h-100">
							<div class="card-body">
								<h3 class="h6">{group.name}</h3>
								<div class="d-flex flex-wrap gap-2">
									{group.skills.map((skill) => (
										<span class="badge text-bg-light border">{skill}</span>
									))}
								</div>
							</div>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="resume-section">
		<h2 class="h4 mb-3">Education</h2>
		<div class="vstack gap-3">
			{
				education.map((item) => (
					<article class="card">
						<div class="card-body">
							<div class="d-flex flex-column flex-md-row justify-content-between gap-2">
								<div>
									<h3 class="h5 mb-1">{item.school}</h3>
									<p class="text-secondary mb-1">{item.degree}</p>
									{
										item.details && (
											<ul class="small text-secondary mb-0">
												{item.details.map((detail) => (
													<li>{detail}</li>
												))}
											</ul>
										)
									}
								</div>
								<p class="small text-secondary mb-0">{item.time}</p>
							</div>
						</div>
					</article>
				))
			}
		</div>
	</section>

	<section class="resume-section">
		<div class="row g-3">
			<div class="col-lg-6">
				<h2 class="h4 mb-3">Publications</h2>
				<div class="list-group">
					{
						publications.map((item) => (
							<div class="list-group-item">
								<h3 class="h6 mb-1">
									{
										item.href ? (
											<a href={item.href} target="_blank" rel="noreferrer">
												{item.title}
											</a>
										) : (
											item.title
										)
									}
								</h3>
								<p class="small text-secondary mb-0">
									{item.source} · {item.date}
								</p>
								<p class="small text-secondary mt-2 mb-0">{item.description}</p>
							</div>
						))
					}
				</div>
			</div>
			<div class="col-lg-6">
				<h2 class="h4 mb-3">Patents</h2>
				<div class="list-group">
					{
						patents.map((item) => (
							<div class="list-group-item">
								<h3 class="h6 mb-1">
									<a href={item.href} target="_blank" rel="noreferrer">
										{item.title}
									</a>
								</h3>
								<p class="small text-secondary mb-0">
									{item.id} · {item.date}
								</p>
								<p class="small text-secondary mt-2 mb-0">{item.description}</p>
							</div>
						))
					}
				</div>
			</div>
		</div>
	</section>

	<section class="resume-section">
		<h2 class="h4 mb-3">Volunteering</h2>
		<div class="list-group">
			{
				volunteering.map((item) => (
					<div class="list-group-item">
						<div class="d-flex flex-column flex-md-row justify-content-between gap-2">
							<div>
								<h3 class="h6 mb-1">{item.role}</h3>
								<p class="small text-secondary mb-1">{item.org}</p>
								<p class="small text-secondary mb-0">{item.details}</p>
							</div>
							<p class="small text-secondary mb-0">{item.time}</p>
						</div>
					</div>
				))
			}
		</div>
	</section>

	<section class="resume-section">
		<h2 class="h4 mb-3">Contact</h2>
		<div class="list-group">
			{
				contactLinks.map((link) => (
					<a class="list-group-item list-group-item-action" href={link.href}>
						{link.label}
					</a>
				))
			}
		</div>
	</section>
</SiteLayout>

<style>
	.resume-section {
		margin-top: 3.5rem;
	}

	.resume-section:first-of-type {
		margin-top: 2.5rem;
	}

	.resume-section h2 {
		margin-bottom: 1.25rem;
		font-weight: 500;
	}

	@media print {
		.resume-section {
			margin-top: 1.5rem;
			break-inside: avoid;
		}
	}
</style>
