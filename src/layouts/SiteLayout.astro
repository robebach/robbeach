---
import "bootstrap/dist/css/bootstrap.min.css";

const {
	title = "Robert Beach",
	description = "Personal site for Robert Beach.",
	active = "home",
} = Astro.props;

const navItems = [
	{ key: "about", label: "About", href: "/" },
	{ key: "projects", label: "Work", href: "/projects" },
	{ key: "blog", label: "Writing", href: "/blog" },
	{ key: "resume", label: "CV", href: "/resume" },
	...(import.meta.env.DEV
		? [{ key: "home-section", label: "Dashboard", href: "/home" }]
		: []),
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&family=IBM+Plex+Mono:wght@400;500&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<div class="site-shell">
			<header class="site-header">
				<nav class="navbar" aria-label="Primary navigation">
					<div class="container navbar-inner">
						<a class="site-wordmark" href="/">Robert Beach</a>
						<ul class="navbar-nav flex-row gap-1 ms-auto" role="list">
							{
								navItems.map((item) => (
									<li class="nav-item">
										<a
											class:list={[
												"nav-link",
												active === item.key && "active",
											]}
											href={item.href}
											aria-current={active === item.key ? "page" : undefined}
										>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
				</nav>
			</header>

			<main class="main-content">
				<div class="container py-5 py-md-6">
					<slot />
				</div>
			</main>

			<footer class="site-footer">
				<div class="container footer-inner">
					<span class="footer-mark">RKB</span>
					<p class="footer-copy">
						&copy; {new Date().getFullYear()} Robert Beach
					</p>
				</div>
			</footer>
		</div>
	</body>
</html>

<style is:global>
	/* ─── Tokens ─────────────────────────────────────────────── */
	:root {
		--font-sans: "Inter", system-ui, sans-serif;
		--font-mono: "IBM Plex Mono", "Fira Code", monospace;

		--ink: #111010;
		--ink-2: #444;
		--ink-3: #888;
		--rule: #d8d5cf;
		--surface: #faf9f7;
		--surface-2: #f0ede8;
		--surface-3: #e6e2db;
		--accent: #1a1a1a;

		--measure: 68ch;
		--nav-h: 56px;

		color-scheme: light;
	}

	/* ─── Reset / Base ───────────────────────────────────────── */
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		font-size: 16px;
		-webkit-font-smoothing: antialiased;
	}

	body {
		min-height: 100vh;
		background: var(--surface);
		color: var(--ink);
		font-family: var(--font-sans);
		font-weight: 400;
		line-height: 1.65;
		overflow-x: hidden;
	}

	a {
		color: inherit;
		text-underline-offset: 0.2em;
	}

	a:hover {
		color: var(--ink);
		opacity: 0.75;
	}

	img,
	svg {
		display: block;
		max-width: 100%;
	}

	/* ─── Shell ──────────────────────────────────────────────── */
	.site-shell {
		min-height: 100vh;
		display: flex;
		flex-direction: column;
	}

	.main-content {
		flex: 1;
	}

	/* ─── Header / Nav ───────────────────────────────────────── */
	.site-header {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--surface);
		border-bottom: 1px solid var(--rule);
	}

	.navbar {
		padding: 0;
	}

	.navbar-inner {
		display: flex;
		align-items: center;
		height: var(--nav-h);
		gap: 2rem;
	}

	.site-wordmark {
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.02em;
		text-decoration: none;
		color: var(--ink);
		flex-shrink: 0;
	}

	.site-wordmark:hover {
		opacity: 1;
		color: var(--ink);
	}

	.navbar-nav {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.nav-link {
		display: inline-block;
		font-family: var(--font-sans);
		font-size: 0.8125rem;
		font-weight: 400;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		text-decoration: none;
		color: var(--ink-3) !important;
		padding: 0.375rem 0.625rem;
		border-radius: 4px;
		transition: color 0.15s ease, background 0.15s ease;
	}

	.nav-link:hover,
	.nav-link.active {
		color: var(--ink) !important;
		opacity: 1;
	}

	.nav-link.active {
		background: var(--surface-2);
	}

	/* ─── Footer ─────────────────────────────────────────────── */
	.site-footer {
		border-top: 1px solid var(--rule);
		background: var(--surface);
	}

	.footer-inner {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding-top: 1.25rem;
		padding-bottom: 1.25rem;
	}

	.footer-mark {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--ink-3);
		letter-spacing: 0.1em;
	}

	.footer-copy {
		font-size: 0.8rem;
		color: var(--ink-3);
		margin: 0;
	}

	/* ─── Typography ─────────────────────────────────────────── */
	h1,
	h2,
	h3,
	h4,
	h5,
	h6 {
		font-family: var(--font-sans);
		font-weight: 400;
		line-height: 1.25;
		color: var(--ink);
		letter-spacing: -0.01em;
	}

	.text-secondary {
		color: var(--ink-2) !important;
	}

	.text-muted {
		color: var(--ink-3) !important;
	}

	/* ─── Layout utilities ───────────────────────────────────── */
	.content-measure {
		max-width: var(--measure);
	}

	.py-md-6 {
		padding-top: 4rem !important;
		padding-bottom: 4rem !important;
	}

	/* ─── Components ─────────────────────────────────────────── */
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.tag {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 400;
		letter-spacing: 0.04em;
		color: var(--ink-3);
		background: var(--surface-2);
		border: 1px solid var(--rule);
		padding: 0.2em 0.6em;
		border-radius: 3px;
	}

	.post-content > * + * {
		margin-top: 1.1rem;
	}

	/* ─── Print ──────────────────────────────────────────────── */
	@media print {
		@page {
			margin: 0.55in;
		}

		body {
			background: #fff;
		}

		.site-header,
		.site-footer,
		.no-print {
			display: none !important;
		}

		.main-content .container {
			max-width: none;
			padding: 0 !important;
		}
	}
</style>
